{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-app",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbit_d1_db",
      // PLACEHOLDER: Replace with your actual Cloudflare D1 UUID from:
      // `npx wrangler d1 create orbit_d1_db`
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "API_VERSION": "v1"
  },
  "env": {
    "staging": {
      "name": "orbit-app-staging",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "orbit_d1_db_staging",
          // PLACEHOLDER: Replace with your actual staging D1 UUID from:
          // `npx wrangler d1 create orbit_d1_db_staging`
          "database_id": "<YOUR_STAGING_D1_DATABASE_ID>",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "API_VERSION": "v1"
      }
    }
  }
}
